package loops.string;
public class ReverseWords {
    public static void main(String[] args) {
        String name = "i love java, the coofee";

        // Split the string into words
        String[] words = name.split(" ");

        // Use StringBuilder to build the reversed sentence
        StringBuilder reversed = new StringBuilder();

        // Traverse words in reverse order
        for (int i = words.length - 1; i >= 0; i--) {
            reversed.append(words[i]).append(" ");
        }

        // Print result (trim removes extra space at the end)
        System.out.println(reversed.toString().trim());
    }
}
