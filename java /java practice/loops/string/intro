package loops.string;

public class reverse {
    public static void main(String[] args) {
        String name = "shadab";
        String reversedname = " ";
        for (int i = name.length() - 1; i >= 0; i--) {
            reversedname = reversedname + name.charAt(i);
        }
        System.out.println(reversedname);
    }
}
